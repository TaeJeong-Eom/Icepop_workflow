      "name": "Execute Workflow"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// 카카오 토큰 발급용 메타데이터\n// ============================================\n// 실행 전 아래 값들 수정:\n//   1. REST_API_KEY: 카카오 디벨로퍼 → 앱 → 앱 키 → REST API 키\n//   2. AUTH_CODE: 인가코드 URL에서 받은 ?code= 다음 값\n//      (인가코드는 10분 만료. 받자마자 실행)\n// ============================================\n\nconst REST_API_KEY = '{{KAKAO_REST_API_KEY}}'\nconst AUTH_CODE = '{{AUTH_CODE}}'\nconst REDIRECT_URI = 'https://your-n8n.example.com/oauth2/callback'\n\nreturn [{\n  json: {\n    REST_API_KEY,\n    AUTH_CODE,\n    REDIRECT_URI\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "3d9282b8-8887-49cd-8d2c-a4ad545c6dca",
      "name": "메타데이터 셋업"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kauth.kakao.com/oauth/token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "authorization_code"
            },
            {
              "name": "client_id",
              "value": "={{ $json.REST_API_KEY }}"
            },
            {
              "name": "redirect_uri",
              "value": "={{ $json.REDIRECT_URI }}"
            },
            {
              "name": "code",
              "value": "={{ $json.AUTH_CODE }}"
            },
            {
              "name": "client_secret",
              "value": "{{CLIENT_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        464,
        0
      ],
      "id": "0fb76a6d-d0c8-4719-a1b2-eb0a59632768",
      "name": "토큰 교환"
    },
    {
      "parameters": {
        "jsCode": "// 토큰 응답 가공 + 발급일 + 만료일 계산\nconst response = $input.first().json\n\nif (!response.refresh_token) {\n  throw new Error(`토큰 발급 실패: ${JSON.stringify(response)}`)\n}\n\nconst today = new Date()\nconst todayStr = today.toISOString().split('T')[0]\n\n// refresh_token 만료일 = 발급일 + 60일\nconst expiryDate = new Date(today.getTime() + 60 * 24 * 60 * 60 * 1000)\nconst expiryStr = expiryDate.toISOString().split('T')[0]\n\nreturn [{\n  json: {\n    토큰명: '카카오',\n    refresh_token: response.refresh_token,\n    발급일: todayStr,\n    만료일: expiryStr,\n    access_token: response.access_token,\n    expires_in: response.expires_in,\n    refresh_token_expires_in: response.refresh_token_expires_in\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        0
      ],
      "id": "f4297047-f990-4222-8a7b-61bf8cee7702",
