      ],
      "id": "601fe30f-9f72-4c04-9e9e-4edd5c19f300",
      "name": "토큰 갱신 요청"
    },
    {
      "parameters": {
        "jsCode": "// access_token만 반환 (호출 워크플로우에서 사용)\nconst response = $input.first().json\n\nif (!response.access_token) {\n  throw new Error(`access_token 발급 실패: ${JSON.stringify(response)}`)\n}\n\nreturn [{\n  json: {\n    access_token: response.access_token,\n    expires_in: response.expires_in\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
