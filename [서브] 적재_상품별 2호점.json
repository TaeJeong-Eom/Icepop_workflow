      "parameters": {
        "jsCode": "// 조회 워크플로우 결과를 시트 적재 형식으로 변환\nconst items = $input.all();\n\nconst result = items.map(item => {\n  const data = item.json;\n  \n  // UNIQUE_KEY 생성: 매출일자_매장코드_바코드\n  const uniqueKey = `${data.SALE_DATE}_${data.SHOP_CD}_${data.BAR_CD}`;\n  \n  return {\n    json: {\n      '매출일자':    data.SALE_DATE,\n      '매장코드':    data.SHOP_CD,\n      '매장명':      data.SHOP_NM,\n      '바코드':      data.BAR_CD,\n      '상품명':      data.PROD_NM,\n      '판매수량':    data.SALE_QTY,\n      '판매금액':    data.DCM_SALE_AMT,\n      '중복방지키':  uniqueKey,\n    }\n  };\n});\n\nreturn result;"
      },
