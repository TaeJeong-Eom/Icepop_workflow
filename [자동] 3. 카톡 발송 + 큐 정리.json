      "name": "발주_대기 gviz 조회"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// 메시지 생성 + 큐 정리 데이터 준비\n// ============================================\n\nfunction parseGviz(raw) {\n  const match = raw.match(/google\\.visualization\\.Query\\.setResponse\\((.*)\\);?\\s*$/s)\n  if (!match) throw new Error('gviz 파싱 실패')\n  return JSON.parse(match[1])\n}\n\nfunction toObjects(parsed) {\n  const cols = parsed.table.cols.map(c => c.label || c.id)\n  return parsed.table.rows.map(row => {\n    const obj = {}\n    row.c.forEach((cell, i) => {\n      obj[cols[i]] = cell?.v ?? ''\n    })\n    return obj\n  })\n}\n\nconst recs = toObjects(parseGviz($('이번주_발주 gviz 조회').first().json.data))\nconst master = toObjects(parseGviz($('마스터 gviz 조회').first().json.data))\nconst queue = toObjects(parseGviz($('발주_대기 gviz 조회').first().json.data))\n\n// === 1. 매장별 추천 분리 ===\nconst EXCLUDE_PRODUCTS = ['비닐봉투']  // 발주 메시지에서 제외할 상품\nconst byStore = { '1호점': [], '2호점': [] }\nfor (const r of recs) {\n  const store = String(r['매장'] || '').trim()\n  if (byStore[store]) {\n    byStore[store].push({\n      상품명: String(r['상품명'] || '').trim(),\n      박스수: r['박스수']\n    })\n  }\n}\n\n// === 2. 매장별 메시지 생성 ===\nconst today = new Date()\nconst dateLabel = `${today.getMonth() + 1}/${today.getDate()}`\n\nfunction buildOrderMessage(store, items) {\n  if (items.length === 0) return null\n  \n  let msg = `발주 부탁드립니다 (${dateLabel}) [${store}]\\n`\n  msg += `(단위: BOX)\\n`\n  for (const item of items) {\n    msg += `* ${item.상품명} : ${item.박스수}\\n`\n  }\n  return msg.trim()\n}\n\nconst msg1호점 = buildOrderMessage('1호점', byStore['1호점'])\nconst msg2호점 = buildOrderMessage('2호점', byStore['2호점'])\n\n// === 3. 신상품 감지 (마스터에서 박스당 수량 빈 상품) ===\nconst newProducts = master.filter(m => {\n  const name = String(m['상품명'] || '').trim()\n  const boxQty = String(m['박스당 수량'] || '').trim()\n  return name && boxQty === ''\n}).map(m => String(m['상품명']).trim())\n\nlet msgNew = null\nif (newProducts.length > 0) {\n  msgNew = `🆕 신상품 추가\\n`\n  msgNew += `판매중상품 시트의 박스당 수량 입력이 필요합니다.\\n\\n`\n  for (const name of newProducts) {\n    msgNew += `* ${name}\\n`\n  }\n  msgNew = msgNew.trim()\n}\n\n// === 4. 큐 정리용 데이터 ===\n// 이번주_발주의 (상품명_매장) 키 = 큐에서 제거할 대상\nconst removeKeys = new Set(\n  recs.map(r => `${String(r['상품명']).trim()}_${String(r['매장']).trim()}`)\n)\n\n// 살아남을 큐 = 추천 안 통과한 행\nconst survivedQueue = queue\n  .map(q => ({\n    바코드: String(q['바코드'] || '').trim(),\n    상품명: String(q['상품명'] || '').trim(),\n    매장: String(q['매장'] || '').trim(),\n    '박스당 수량': q['박스당 수량'],\n    등록일: String(q['등록일'] || '').trim()\n  }))\n  .filter(q => !removeKeys.has(`${q.상품명}_${q.매장}`))\n  .filter(q => q.상품명)\n\nreturn [{\n  json: {\n    msg1호점,\n    msg2호점,\n    msgNew,\n    survivedQueue,\n    stats: {\n      추천_1호점: byStore['1호점'].length,\n      추천_2호점: byStore['2호점'].length,\n      신상품: newProducts.length,\n      큐_제거: removeKeys.size,\n      큐_살아남음: survivedQueue.length\n    }\n  }\n}]"
      },
