      ],
      "id": "f75e8832-c60e-4210-8c07-fdbb742f63e7",
      "name": "바코드별 매출 조회"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst allItems = $input.all();\nconst allShops = $('매장 목록 생성').all();\n\nconst SALE_DATE = $('set_date').first().json.date1;\n\nfor (let i = 0; i < allItems.length; i++) {\n  const xmlData = allItems[i].json.data;\n  const shopInfo = allShops[i].json;\n  \n  const rows = xmlData.match(/<TR>([\\s\\S]*?)<\\/TR>/g) || [];\n  \n  rows.forEach(row => {\n    const cells = row.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/g) || [];\n    const values = cells.map(cell => cell.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/)[1]);\n    \n    if (values[1]) {  // 빈 행 제외 (BAR_CD 있는 행만)\n      results.push({\n        json: {\n          SHOP_CD:      shopInfo.shop_cd,\n          SHOP_NM:      shopInfo.shop_nm,\n          SALE_DATE,\n          BAR_CD:       values[1],          // ← 인덱스 0 → 1\n          PROD_NM:      values[2],          // ← 인덱스 1 → 2\n          SALE_QTY:     parseInt(values[3]) || 0,    // ← 인덱스 2 → 3\n          DCM_SALE_AMT: parseInt(values[4]) || 0,    // ← 인덱스 3 → 4\n        }\n      });\n    }\n  });\n}\n\nreturn results;"
      },
