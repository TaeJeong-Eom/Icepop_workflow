    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://k.poshub.co.kr/ddd.sheetAction",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "=JSESSIONID={{$('Call \\'[서브] POSHUB 인증\\'').item.json.jsessionid}}; user_id={{POS_USER_ID}}; user_pwd={{POS_PASSWORD}}; s_SHOP_CD_S=STORE_CODE_1; s_SHOP_NM_S=; s_GROUP_TYPE_S=; month1=2026-05; month2=2026-05; s_SHOP_CD_M=; s_SHOP_NM_M=; s_GROUP_TYPE_M="
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded; charset=EUC-KR"
            },
            {
              "name": "User-Agent",
              "value": "IBLeaders IBSheet"
            },
            {
              "name": "Referer",
              "value": "http://k.poshub.co.kr/sale/sale/barcd010.jsp"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "=BarCD=&ProdNM=&date_period1=0&date1_1={{$json.date1}}&date1_2={{$json.date1}}&S_CONTROLLER=sale.sale.barcd010&S_METHOD=search&S_SAVENAME=%7CBAR_CD%7CPROD_NM%7CSALE_QTY%7CDCM_SALE_AMT%7C&S_FORWARD=&S_TREECOL=&SHEETSEQ=1&Mp=BarCD&s_SHOP_CD={{$json.shop_cd}}&MS_fg=M&s_SHOP_NM=&GROUP_TYPE_M=",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
