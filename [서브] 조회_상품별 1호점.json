    },
    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth() + 1).padStart(2, '0');\nconst dd = String(today.getDate()).padStart(2, '0');\nconst date1 = `${yyyy}-${mm}-${dd}`;\n\nreturn [{ json: { date1 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "8b707825-4a21-44fa-8440-3b1517930e70",
      "name": "set_date"
    },
    {
      "parameters": {
        "jsCode": "// === 매장 목록 (워크플로우별로 여기만 수정) ===\nconst shops = [\n  { shop_cd: 'STORE_CODE_1', shop_nm: '1호점' },\n];\n// ===========================================\n\nconst date1 = $input.first().json.date1;\n\nreturn shops.map(shop => ({\n  json: {\n    ...shop,\n    date1,\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
