      "name": "영수증별 매출 조회"
    },
    {
      "parameters": {
        "jsCode": "const xmlData = $input.first().json.data;\nconst rows = xmlData.match(/<TR>([\\s\\S]*?)<\\/TR>/g) || [];\n\n// === 매장 정보 ===\nconst SHOP_CD = 'STORE_CODE_1';\nconst SHOP_NM = '아이스팝1호점';\n// ==================\n\nconst result = [];\n\nrows.forEach(row => {\n  const cells = row.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/g) || [];\n  const values = cells.map(cell => cell.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/)[1]);\n  \n  if (!values[5]) return; // BILL_NO 없으면 빈 행\n  \n  const SALE_DATE_RAW = values[3];\n  const SALE_DATE = SALE_DATE_RAW.includes('-')\n    ? SALE_DATE_RAW\n    : `${SALE_DATE_RAW.slice(0,4)}-${SALE_DATE_RAW.slice(4,6)}-${SALE_DATE_RAW.slice(6,8)}`;\n  \n  const POS_NO = values[4];\n  const BILL_NO = values[5];\n  const DTL_NO = values[6];\n  const BAR_CD = values[10];\n  const PROD_NM = values[11];\n  const SALE_AMT = parseInt(values[12]) || 0;\n  const DC_AMT = parseInt(values[13]) || 0;\n  const DCM_SALE_AMT = parseInt(values[14]) || 0;\n  \n  const 중복방지키 = `${SALE_DATE.replace(/-/g, '')}_${SHOP_CD}_${POS_NO}_${BILL_NO}_${DTL_NO}`;\n  \n  result.push({\n    json: {\n      매출일자: SALE_DATE,\n      매장코드: SHOP_CD,\n      매장명: SHOP_NM,\n      포스: POS_NO,\n      영수: BILL_NO,\n      순번: DTL_NO,\n      바코드: BAR_CD,\n      상품명: PROD_NM,\n      총매출: SALE_AMT,\n      할인액: DC_AMT,\n      실매출: DCM_SALE_AMT,\n      중복방지키\n    }\n  });\n});\n\nreturn result;"
      },
