    {
      "parameters": {
        "jsCode": "// ============================================\n// 워크플로우 2: 발주 추천\n// - 발주_대기 각 행:\n//   - 박스당 수량 있고\n//     - 박스수 = 비율의 정수부 + 소수부가 BOX_ADD_T 이상이면 1 추가. 1박스 이상이면 추천\n// - 이번주_발주 시트에 적재 (Clear + Append)\n// - 발주_대기는 안 건드림 (워크플로우 3이 카톡 후 정리)\n// ============================================\nconst BOX_ADD_T = 0.7  // 박스 추가 임계값. 소수부가 이 값 이상일 때만 박스 1개 추가. 조정은 여기서만.\n\nfunction parseGviz(raw) {\n  const match = raw.match(/google\\.visualization\\.Query\\.setResponse\\((.*)\\);?\\s*$/s)\n  if (!match) throw new Error('gviz 파싱 실패')\n  return JSON.parse(match[1])\n}\n\nfunction toObjects(parsed) {\n  const cols = parsed.table.cols.map(c => c.label || c.id)\n  return parsed.table.rows.map(row => {\n    const obj = {}\n    row.c.forEach((cell, i) => {\n      obj[cols[i]] = cell?.v ?? ''\n    })\n    return obj\n  })\n}\n\nconst queue = toObjects(parseGviz($('발주_대기 gviz 조회').first().json.data))\nconst sales = toObjects(parseGviz($('6주간_판매량 gviz 조회').first().json.data))\n\n// === 1. 6주간_판매량 맵 (상품명 → 매장별 7일 판매량) ===\nconst salesByName = {}\nfor (const s of sales) {\n  const name = String(s['상품명'] || '').trim()\n  if (!name) continue\n  salesByName[name] = {\n    '1호점_7일': parseInt(s['1호점_7일']) || 0,\n    '2호점_7일': parseInt(s['2호점_7일']) || 0\n  }\n}\n\n// === 2. 발주_대기 각 행 평가 ===\nconst recommendations = []\n\nfor (const q of queue) {\n  const name = String(q['상품명'] || '').trim()\n  const store = String(q['매장'] || '').trim()\n  const barcode = String(q['바코드'] || '').trim()\n  const boxQty = parseInt(q['박스당 수량']) || 0\n  \n  if (!name || !store) continue\n  if (boxQty === 0) continue  // 박스당 수량 없으면 평가 X\n  \n  const sale = salesByName[name]\n  if (!sale) continue  // 6주간_판매량에 없음 (드문 케이스)\n  \n  const sold7 = sale[`${store}_7일`] || 0\n  const ratio = sold7 / boxQty\n  const frac = ratio % 1\n  const boxes = Math.floor(ratio) + (frac >= BOX_ADD_T ? 1 : 0)\n  \n  // 박스 추가 임계값 룰 - 편입 기준과 추가 기준을 BOX_ADD_T 하나로 통일\n  if (boxes >= 1) {\n    recommendations.push({\n      바코드: barcode,\n      상품명: name,\n      매장: store,\n      박스수: boxes,\n      판매량_7일: sold7\n    })\n  }\n}\n\n// 정렬: 매장 → 상품명\nrecommendations.sort((a, b) => {\n  if (a.매장 !== b.매장) return a.매장.localeCompare(b.매장, 'ko')\n  return a.상품명.localeCompare(b.상품명, 'ko')\n})\n\nreturn [{\n  json: {\n    recommendations,\n    stats: {\n      평가_대상: queue.length,\n      추천_총: recommendations.length,\n      추천_1호점: recommendations.filter(r => r.매장 === '1호점').length,\n      추천_2호점: recommendations.filter(r => r.매장 === '2호점').length\n    }\n  }\n}]"
      },
