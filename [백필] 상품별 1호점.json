      "name": "바코드별 매출 조회"
    },
    {
      "parameters": {
        "jsCode": "const xmlData = $input.first().json.data;\nconst rows = xmlData.match(/<TR>([\\s\\S]*?)<\\/TR>/g) || [];\n\nconst SHOP_CD = 'STORE_CODE_1';\nconst SHOP_NM = '1호점';\nconst SALE_DATE = $('Loop Over Days').item.json.date1;\n\nconst results = [];\n\nrows.forEach(row => {\n  const cells = row.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/g) || [];\n  const values = cells.map(cell => cell.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/)[1]);\n  \n  if (!values[1]) return;\n  \n  const BAR_CD = values[1];\n  const PROD_NM = values[2];\n  const SALE_QTY = parseInt(values[3]) || 0;\n  const DCM_SALE_AMT = parseInt(values[4]) || 0;\n  \n  const 중복방지키 = `${SALE_DATE.replace(/-/g, '')}_${SHOP_CD}_${BAR_CD}`;\n  \n  results.push({\n    json: {\n      매출일자: SALE_DATE,\n      매장코드: SHOP_CD,\n      매장명: SHOP_NM,\n      바코드: BAR_CD,\n      상품명: PROD_NM,\n      판매수량: SALE_QTY,\n      매출액: DCM_SALE_AMT,\n      중복방지키\n    }\n  });\n});\n\nreturn results;"
      },
