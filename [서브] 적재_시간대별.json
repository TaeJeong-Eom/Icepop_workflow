    {
      "parameters": {
        "jsCode": "// 조회 워크플로우 결과를 시트 적재 형식으로 변환\nconst items = $input.all();\n\nconst result = items.map(item => {\n  const data = item.json;\n  \n  // UNIQUE_KEY 생성: 매출일자_매장코드_시간대\n  const uniqueKey = `${data.SALE_DATE}_${data.SHOP_CD}_${data.HOUR}`;\n  \n  return {\n    json: {\n      '매출일자':    data.SALE_DATE,\n      '매장코드':    data.SHOP_CD,\n      '매장명':      data.SHOP_NM,\n      '요일':        data.DY,\n      '날씨':        data.WEATHER,\n      '시간대':      data.HOUR,\n      '시간대매출':  data.SALE_AMT,\n      '시간대수량':  data.SALE_QTY,\n      '일총매출':    data.DAY_TOTAL_AMT,\n      '일총수량':    data.DAY_TOTAL_QTY,\n      '중복방지키':  uniqueKey,\n    }\n  };\n});\n\nreturn result;"
      },
