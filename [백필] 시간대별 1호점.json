      "name": "시간대별 매출 조회"
    },
    {
      "parameters": {
        "jsCode": "const xmlData = $input.first().json.data;\nconst rows = xmlData.match(/<TR>([\\s\\S]*?)<\\/TR>/g) || [];\n\n// === 매장 정보 ===\nconst SHOP_CD = 'STORE_CODE_1';\nconst SHOP_NM = '아이스팝1호점';\n// ==================\n\nconst result = [];\n\nrows.forEach(row => {\n  const cells = row.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/g) || [];\n  const values = cells.map(cell => cell.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/)[1]);\n  \n  if (!values[1]) return;\n  \n  const SALE_DATE_RAW = values[1];\n  const SALE_DATE = SALE_DATE_RAW.includes('-')\n    ? SALE_DATE_RAW\n    : `${SALE_DATE_RAW.slice(0,4)}-${SALE_DATE_RAW.slice(4,6)}-${SALE_DATE_RAW.slice(6,8)}`;\n  const DY        = values[2];\n  const WEATHER   = values[4];\n  const DAY_TOTAL_AMT = parseInt(values[5]) || 0;\n  const DAY_TOTAL_QTY = parseInt(values[6]) || 0;\n  \n  for (let hour = 0; hour < 24; hour++) {\n    const baseIdx = 8 + (hour * 3);\n    const amt = parseInt(values[baseIdx]) || 0;\n    const qty = parseInt(values[baseIdx + 1]) || 0;\n    const HOUR = String(hour).padStart(2, '0');\n    \n    const 중복방지키 = `${SALE_DATE}_${SHOP_CD}_${HOUR}`;\n    \n    result.push({\n      json: {\n        매출일자: SALE_DATE,\n        매장코드: SHOP_CD,\n        매장명: SHOP_NM,\n        요일: DY,\n        날씨: WEATHER,\n        시간대: HOUR,\n        시간대매출: amt,\n        시간대수량: qty,\n        일총매출: DAY_TOTAL_AMT,\n        일총수량: DAY_TOTAL_QTY,\n        중복방지키\n      }\n    });\n  }\n});\n\nreturn result;"
      },
