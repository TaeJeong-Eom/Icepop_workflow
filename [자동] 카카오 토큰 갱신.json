    },
    {
      "parameters": {
        "jsCode": "function parseGviz(raw) {\n  const match = raw.match(/google\\.visualization\\.Query\\.setResponse\\((.*)\\);?\\s*$/s)\n  if (!match) throw new Error('gviz 파싱 실패')\n  return JSON.parse(match[1])\n}\n\nconst parsed = parseGviz($input.first().json.data)\n\nif (!parsed.table.rows || parsed.table.rows.length === 0) {\n  throw new Error('카카오_토큰 시트가 비어있음')\n}\n\nconst row = parsed.table.rows[1]\nconst refreshToken = row.c[1]?.v || ''\n\nif (!refreshToken) {\n  throw new Error('refresh_token이 시트에 없음')\n}\n\nreturn [{\n  json: {\n    REST_API_KEY: '{{KAKAO_REST_API_KEY}}',\n    refresh_token: refreshToken,\n    debug_row_structure: JSON.stringify(row)\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        16
      ],
      "id": "9b8a8cfb-ae5d-48ed-a28f-c9edd809bf32",
      "name": "기존 refresh_token 추출"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kauth.kakao.com/oauth/token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
