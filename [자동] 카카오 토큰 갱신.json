      "id": "4318be51-c49b-4e6a-af34-a92b3dab04e0",
      "name": "토큰 갱신 요청"
    },
    {
      "parameters": {
        "jsCode": "// 응답 처리:\n// - access_token: 항상 받음 (6시간)\n// - refresh_token: refresh 만료 1달 이내일 때만 받음\nconst response = $input.first().json\n\nif (!response.access_token) {\n  throw new Error(`갱신 실패: ${JSON.stringify(response)}`)\n}\n\nconst hasNewRefreshToken = !!response.refresh_token\n\nconst today = new Date()\nconst todayStr = today.toISOString().split('T')[0]\nconst expiryDate = new Date(today.getTime() + 60 * 24 * 60 * 60 * 1000)\nconst expiryStr = expiryDate.toISOString().split('T')[0]\n\nreturn [{\n  json: {\n    access_token: response.access_token,\n    new_refresh_token: response.refresh_token || null,\n    hasNewRefreshToken,\n    발급일: todayStr,\n    만료일: expiryStr,\n    토큰명: '카카오'\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        16
      ],
      "id": "8392d9db-1ac4-427b-b065-ab374fbddb19",
