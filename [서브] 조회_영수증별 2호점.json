        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "=S_CONTROLLER=sale.sale.period_bill010&S_METHOD=search&S_SAVENAME=%7CSHOP_CD%7CSHOP_NM%7CSALE_DATE%7CPOS_NO%7CBILL_NO%7CDTL_NO%7CBRAND_CD%7CBRAND_NM%7CPROD_CD%7CBAR_CD%7CPROD_NM%7CSALE_AMT%7CDC_AMT%7CDCM_SALE_AMT%7C&S_FORWARD=&S_TREECOL=&SHEETSEQ=1&MS_fg=M&GROUP_TYPE_M=&mySheet1=&date1_1={{$json.date1}}&date1_2={{$json.date1}}&date_period1=0&s_SHOP_CD=STORE_CODE_2&s_SHOP_NM=%5BSTORE_CODE_2%5D+%BE%C6%C0%CC%BD%BA%C6%CB2%C8%A3%C1%A1",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        0
      ],
      "id": "01fdea9c-b2a3-4887-bf76-b5852b0f2a96",
      "name": "영수증별 매출 조회"
    },
    {
      "parameters": {
        "jsCode": "const xmlData = $input.first().json.data;\nconst rows = xmlData.match(/<TR>([\\s\\S]*?)<\\/TR>/g) || [];\n\n// === 매장 정보 (워크플로우별로 여기만 수정) ===\nconst SHOP_CD = 'STORE_CODE_2';\nconst SHOP_NM = '아이스팝2호점';\n// ===========================================\n\nconst result = [];\n\nrows.forEach(row => {\n  const cells = row.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/g) || [];\n  const values = cells.map(cell => cell.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/)[1]);\n  \n  // values[0]은 체크박스(빈 값), values[1]부터 데이터\n  // 매핑: 1=SHOP_CD, 2=SHOP_NM, 3=SALE_DATE, 4=POS_NO, 5=BILL_NO, 6=DTL_NO,\n  //       7=BRAND_CD, 8=BRAND_NM, 9=PROD_CD, 10=BAR_CD, 11=PROD_NM,\n  //       12=SALE_AMT, 13=DC_AMT, 14=DCM_SALE_AMT\n  \n  if (!values[5]) return; // BILL_NO 없으면 빈 행\n  \n  const SALE_DATE_RAW = values[3];\n  const SALE_DATE = SALE_DATE_RAW.includes('-')\n    ? SALE_DATE_RAW\n    : `${SALE_DATE_RAW.slice(0,4)}-${SALE_DATE_RAW.slice(4,6)}-${SALE_DATE_RAW.slice(6,8)}`;\n  \n  const POS_NO = values[4];\n  const BILL_NO = values[5];\n  const DTL_NO = values[6];\n  const BAR_CD = values[10];\n  const PROD_NM = values[11];\n  const SALE_AMT = parseInt(values[12]) || 0;\n  const DC_AMT = parseInt(values[13]) || 0;\n  const DCM_SALE_AMT = parseInt(values[14]) || 0;\n  \n  const 중복방지키 = `${SALE_DATE.replace(/-/g, '')}_${SHOP_CD}_${POS_NO}_${BILL_NO}_${DTL_NO}`;\n  \n  result.push({\n    json: {\n      매출일자: SALE_DATE,\n      매장코드: SHOP_CD,\n      매장명: SHOP_NM,\n      포스: POS_NO,\n      영수: BILL_NO,\n      순번: DTL_NO,\n      바코드: BAR_CD,\n      상품명: PROD_NM,\n      총매출: SALE_AMT,\n      할인액: DC_AMT,\n      실매출: DCM_SALE_AMT,\n      중복방지키\n    }\n  });\n});\n\nreturn result;"
      },
