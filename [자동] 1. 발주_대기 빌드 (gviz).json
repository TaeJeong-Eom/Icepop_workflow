      "name": "발주_대기 gviz 조회"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// 워크플로우 1: 발주_대기 빌드\n// - 6주간_판매량의 7일 판매 > 0 상품 → 발주_대기에 등록\n// - 마스터 매칭 (바코드, 박스당 수량)\n// - 기존 등록일 유지\n// - 42일 도태\n// - 신상품 → 마스터에 추가 대상\n// ============================================\n\nconst today = new Date()\nconst todayStr = today.toISOString().split('T')[0]\n\n// gviz 응답 파싱 함수\nfunction parseGviz(raw) {\n  const match = raw.match(/google\\.visualization\\.Query\\.setResponse\\((.*)\\);?\\s*$/s)\n  if (!match) throw new Error('gviz 파싱 실패')\n  return JSON.parse(match[1])\n}\n\n// gviz table → 객체 배열 (헤더 기반)\nfunction toObjects(parsed) {\n  const cols = parsed.table.cols.map(c => c.label || c.id)\n  return parsed.table.rows.map(row => {\n    const obj = {}\n    row.c.forEach((cell, i) => {\n      obj[cols[i]] = cell?.v ?? ''\n    })\n    return obj\n  })\n}\n\nconst master = toObjects(parseGviz($('마스터 gviz 조회').first().json.data))\nconst sales = toObjects(parseGviz($('6주간_판매량 gviz 조회').first().json.data))\nconst queue = toObjects(parseGviz($('발주_대기 gviz 조회').first().json.data))\n\n// === 1. 마스터 맵 (상품명 → 마스터 행) ===\nconst masterByName = {}\nfor (const m of master) {\n  const name = String(m['상품명'] || '').trim()\n  if (name) masterByName[name] = m\n}\n\n// === 2. 발주_대기 맵 (상품명_매장 → 등록일) ===\nconst queueByKey = {}\nfor (const q of queue) {\n  const name = String(q['상품명'] || '').trim()\n  const store = String(q['매장'] || '').trim()\n  const regDate = String(q['등록일'] || '').trim()\n  if (name && store) {\n    queueByKey[`${name}_${store}`] = regDate\n  }\n}\n\n// === 3. 신상품 감지 ===\nconst newProducts = []\nfor (const s of sales) {\n  const name = String(s['상품명'] || '').trim()\n  if (!name) continue\n  if (!masterByName[name]) {\n    newProducts.push({\n      No: '',\n      상품명: name,\n      바코드: '',\n      '개당 판매가': '',\n      '박스당 수량': ''\n    })\n  }\n}\n\n// === 4. 새 발주_대기 빌드 ===\nconst newQueue = []\n\nfor (const s of sales) {\n  const name = String(s['상품명'] || '').trim()\n  if (!name) continue\n  \n  const masterItem = masterByName[name]\n  if (!masterItem) continue  // 마스터에 없으면 스킵 (신상품은 다음 주부터)\n  \n  const barcode = String(masterItem['바코드'] || '').trim()\n  const boxQty = masterItem['박스당 수량']\n  \n  for (const store of ['1호점', '2호점']) {\n    const sold7 = parseInt(s[`${store}_7일`]) || 0\n    if (sold7 <= 0) continue  // 해당 매장 7일 판매 없음\n    \n    const key = `${name}_${store}`\n    const existingRegDate = queueByKey[key]\n    \n    let regDate\n    if (existingRegDate) {\n      regDate = existingRegDate\n      \n      // 42일 경과 체크 (도태)\n      const regDateObj = new Date(regDate)\n      const daysInQueue = (today - regDateObj) / (24 * 60 * 60 * 1000)\n      if (daysInQueue >= 42) continue\n    } else {\n      regDate = todayStr\n    }\n    \n    newQueue.push({\n      바코드: barcode,\n      상품명: name,\n      매장: store,\n      '박스당 수량': boxQty,\n      등록일: regDate\n    })\n  }\n}\n\nreturn [{\n  json: {\n    newProducts,\n    newQueue,\n    stats: {\n      마스터_총: master.length,\n      매출_총: sales.length,\n      큐_기존: queue.length,\n      신상품: newProducts.length,\n      큐_새: newQueue.length,\n      큐_신규등록: newQueue.filter(q => q.등록일 === todayStr).length,\n      큐_기존유지: newQueue.filter(q => q.등록일 !== todayStr).length\n    }\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
