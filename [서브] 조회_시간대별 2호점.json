      "id": "b46e5315-b5d6-4d80-bcd7-863618f543c9",
      "name": "시간대별 매출 조회"
    },
    {
      "parameters": {
        "jsCode": "const xmlData = $input.first().json.data;\nconst rows = xmlData.match(/<TR>([\\s\\S]*?)<\\/TR>/g) || [];\n\n// === 매장 정보 (워크플로우별로 여기만 수정) ===\nconst SHOP_CD = 'STORE_CODE_2';\nconst SHOP_NM = '아이스팝2호점';\n// ===========================================\n\nconst result = [];\n\nrows.forEach(row => {\n  const cells = row.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/g) || [];\n  const values = cells.map(cell => cell.match(/<TD><!\\[CDATA\\[(.*?)\\]\\]><\\/TD>/)[1]);\n  \n  if (!values[1]) return;\n  \n  const SALE_DATE_RAW = values[1];\n  const SALE_DATE = `${SALE_DATE_RAW.slice(0,4)}-${SALE_DATE_RAW.slice(4,6)}-${SALE_DATE_RAW.slice(6,8)}`;\n  const DY        = values[2];\n  const WEATHER   = values[4];\n  const DAY_TOTAL_AMT = parseInt(values[5]) || 0;\n  const DAY_TOTAL_QTY = parseInt(values[6]) || 0;\n  \n  for (let hour = 0; hour < 24; hour++) {\n    const baseIdx = 8 + (hour * 3);\n    const amt = parseInt(values[baseIdx]) || 0;\n    const qty = parseInt(values[baseIdx + 1]) || 0;\n    \n    result.push({\n      json: {\n        SHOP_CD,\n        SHOP_NM,\n        SALE_DATE,\n        DY,\n        WEATHER,\n        HOUR: String(hour).padStart(2, '0'),\n        SALE_AMT: amt,\n        SALE_QTY: qty,\n        DAY_TOTAL_AMT,\n        DAY_TOTAL_QTY,\n      }\n    });\n  }\n});\n\nreturn result;"
      },
